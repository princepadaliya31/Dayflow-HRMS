# Root .gitignore for Dayflow-HRMS

# Node dependencies
**/node_modules/

# Built assets
**/dist/
**/.output/
**/.next/

# Local configuration and environment variables
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
